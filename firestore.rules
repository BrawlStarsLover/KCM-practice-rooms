rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == "TdvMfESAnahSxiSGdZvzOGEiAAV2";
    }

    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function detailsPath(reqId) {
      return /databases/$(database)/documents/requestDetails/$(reqId);
    }

    // A public pending entry from a visitor: id, name and the visitor's own
    // anonymous uid (so each browser can only have one live request per period)
    function validEntry(e) {
      return e is map
        && e.keys().hasOnly(['id', 'name', 'uid'])
        && e.keys().hasAll(['id', 'name', 'uid'])
        && isStr(e.id, 8, 40)
        && isStr(e.name, 1, 60)
        && e.uid == request.auth.uid;
    }

    // The appended entry must come with a brand-new details doc for this same
    // cell and name, created in the same batch
    function appendedEntryOk(cellId, e) {
      return validEntry(e)
        && !exists(detailsPath(e.id))
        && existsAfter(detailsPath(e.id))
        && getAfter(detailsPath(e.id)).data.cellId == cellId
        && getAfter(detailsPath(e.id)).data.name == e.name
        && getAfter(detailsPath(e.id)).data.uid == e.uid;
    }

    // One live request per browser per period: not already waiting, not already in.
    // pendingUids / confirmedUids mirror the uids in pending / confirmed.
    function uidAppendOk() {
      let beforeUids = resource.data.get('pendingUids', []);
      let afterUids = request.resource.data.get('pendingUids', []);
      return !(request.auth.uid in beforeUids)
        && !(request.auth.uid in resource.data.get('confirmedUids', []))
        && afterUids.size() == beforeUids.size() + 1
        && afterUids.hasAll(beforeUids)
        && request.auth.uid in afterUids;
    }

    // A visitor may only append exactly one entry to the end of `pending` on an
    // OPEN, non-full slot — every existing entry stays as it was, and nothing
    // else in the doc (status, supervisor, confirmed, declinedIds) changes
    function isVisitorAppend(cellId) {
      let before = resource.data.pending;
      let after = request.resource.data.pending;
      return request.auth != null
        && resource.data.status == 'open'
        && resource.data.confirmed.size() < 10
        && before.size() < 50
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pending', 'pendingUids'])
        && uidAppendOk()
        && after is list
        && after.size() == before.size() + 1
        // (an empty slice list[0:0] throws in rules, so the first applicant skips the check)
        && (before.size() == 0 || after[0:before.size()] == before)
        && appendedEntryOk(cellId, after[before.size()]);
    }

    function validDetails(reqId) {
      let d = request.resource.data;
      return request.auth != null
        && isStr(reqId, 8, 40)
        && d.keys().hasOnly(['cellId', 'name', 'instrument', 'note', 'createdAt', 'uid'])
        && d.keys().hasAll(['cellId', 'name', 'instrument', 'note', 'createdAt', 'uid'])
        && d.uid == request.auth.uid
        && isStr(d.cellId, 4, 40)
        && isStr(d.name, 1, 60)
        && isStr(d.instrument, 0, 40)
        && isStr(d.note, 0, 200)
        && d.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/cells/$(d.cellId))
        && getAfter(/databases/$(database)/documents/cells/$(d.cellId)).data.pending
             .hasAny([{'id': reqId, 'name': d.name, 'uid': d.uid}]);
    }

    // Practice-room period slots (public). Each doc looks like:
    // { status: 'open'|'closed', supervisor: string,
    //   pending: [{id, name, uid}], confirmed: [{id, name, uid}], declinedIds: [id],
    //   pendingUids: [uid], confirmedUids: [uid] }
    match /cells/{cellId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if !isAdmin() && isVisitorAppend(cellId);
    }

    // Private part of each request (instrument, reason) — admin eyes only.
    // Visitors can create one only together with its pending entry.
    match /requestDetails/{reqId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validDetails(reqId);
    }

    // Supervisor-role applications
    match /supervisorApps/{appId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'message', 'ts'])
        && request.resource.data.keys().hasAll(['name', 'message', 'ts'])
        && isStr(request.resource.data.name, 1, 60)
        && isStr(request.resource.data.message, 0, 200)
        && request.resource.data.ts == request.time
      );
    }

    // Approved supervisors list (populates the "who's supervising" dropdown)
    match /supervisors/{supId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
